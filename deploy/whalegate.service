# systemd --user unit for a source checkout at ~/whalegate (the release installer writes its own unit).
#   cp deploy/whalegate.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#   systemctl --user enable --now whalegate && journalctl --user -u whalegate -f
[Unit]
Description=whalegate (OpenAI-compatible gateway into DeepSeek web)
After=network-online.target

[Service]
WorkingDirectory=%h/whalegate
ExecStart=%h/whalegate/target/release/whalegate serve
Environment=DS_PORT=8790
# 2 in-flight requests per account is the safe ceiling
Environment=DS_MAX_CONC_PER_ACC=2
Environment=DS_QUEUE_WAIT_SECS=120
Environment=DS_SESSION_ROTATE=30
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
