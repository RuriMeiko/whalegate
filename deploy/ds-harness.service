# systemd --user: cp deploy/ds-harness.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#                 systemctl --user enable --now ds-harness && journalctl --user -u ds-harness -f
[Unit]
Description=DeepSeek Harness (OpenAI-compatible proxy over DeepSeek web)
After=network-online.target

[Service]
WorkingDirectory=%h/ds-harness
ExecStart=%h/ds-harness/target/release/deepseek-harness serve
Environment=DS_PORT=8790
# Pool 9 acc: mỗi acc tối đa 2 call đồng thời => ~18 call song song
Environment=DS_MAX_CONC_PER_ACC=2
Environment=DS_QUEUE_WAIT_SECS=120
Environment=DS_SESSION_ROTATE=30
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
